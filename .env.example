# Story Booker Environment Variables

# ==================== ComfyUI Connection Configuration ====================
# ComfyUI Connection Settings
# Note: Leave COMFYUI_HOST empty to use auto-discovery (recommended)
COMFYUI_HOST=
COMFYUI_PORT=8188
COMFYUI_TIMEOUT=10
COMFYUI_MAX_RETRIES=3
COMFYUI_RETRY_DELAY=2

# --- ComfyUI Prompt Configuration ---
# The default text to append to every generation (quality, style, etc.)
CHARACTER_WORKFLOW_NAME="character_creator"
POSITIVE_PROMPT="high quality, masterpiece, detailed, 8k"
NEGATIVE_PROMPT="low quality, blurry, distorted, text, watermark"
USE_NEGATIVE_PROMPT=false

# ==================== Ollama Configuration ====================
# Ollama Connection Settings
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434
OLLAMA_MODEL="llama3.1:8b"
OLLAMA_TIMEOUT=30
OLLAMA_MAX_RETRIES=3

# Description Generation Settings
DESCRIPTION_STYLE="detailed, evocative, suitable for image generation"
DESCRIPTION_TEMPERATURE=0.7
DESCRIPTION_MAX_TOKENS=512

# Environment Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
